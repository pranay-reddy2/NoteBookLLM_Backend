# ── LLM (at least one key) ────────────────────────────────────────────────────
GROQ_API_KEY=            # free: https://console.groq.com/keys
GEMINI_API_KEY=          # free: https://aistudio.google.com/apikey  (also used for embeddings)
OPENROUTER_API_KEY=      # optional, only ":free" models are used

LLM_PROVIDER=groq                      # groq | gemini | openrouter
LLM_FALLBACK_PROVIDERS=gemini,openrouter
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_MODEL=minimax/minimax-m2.7:free

# ── Embeddings ────────────────────────────────────────────────────────────────
EMBEDDING_PROVIDER=gemini              # gemini | local (local needs requirements-local-embeddings.txt)
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_EMBED_DIM=768
AUTO_MIGRATE_LEGACY=1                  # re-embed the old MiniLM collection on first use

# ── Demo guard rails ──────────────────────────────────────────────────────────
DAILY_REQUEST_CAP=200
CONTACT_EMAIL=pranayreddy672@gmail.com
ANSWER_CACHE_SIZE=500

# ── Misc ──────────────────────────────────────────────────────────────────────
CHROMA_PATH=./chroma_db
PORT=8000
ENV=production
